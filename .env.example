# Copy to .env.local and adjust as needed for local development.
# Vite loads .env, .env.local, .env.[mode], etc. See https://vitejs.dev/guide/env-and-mode

# Model & Professional onboarding: omit or false = submit allowed without ID step (saved as manual_review for admin).
# Set true to block submit until identity step returns verified or manual_review (after Rekognition or demo flow).
VITE_REQUIRE_ONBOARD_IDENTITY=false

# When true (Model & Pro): always save identity as manual_review on submit regardless of Rekognition outcome.
VITE_SKIP_IDENTITY_VERIFICATION=false

# Waitlist launch: set to true to show full portals to any signed-in user (non-admins too).
# Omit or false in production while only Cognito Admin should see dashboards.
# VITE_FULL_APP_ACCESS=true

# Local dev: allow /admin through PrivateBeta shell (matches ProtectedRoute localhost admin bypass).
# Set to false to require real Cognito Admin group even on localhost.
# VITE_DEV_ADMIN_BYPASS=false

# Use mock data when real schema/DB is unavailable (e.g. amplify_outputs has Todo demo schema)
# When true, photo upload + profile save are BLOCKED on real onboard — use false for model signup testing.
# VITE_USE_MOCK_DATA=true

# Model onboard today (copy block to .env.local):
# VITE_USE_MOCK_DATA=false
# VITE_BYPASS_ONBOARDING_VERIFICATION=true
# VITE_REQUIRE_ONBOARD_IDENTITY=false
# VITE_SKIP_IDENTITY_VERIFICATION=true

# --- Amplify Hosting (branch: master) — set in Console → Environment variables ---
# VITE_USE_MOCK_DATA=false
# VITE_DEV_ADMIN_BYPASS=false
# VITE_FULL_APP_ACCESS=false
# VITE_REQUIRE_ONBOARD_IDENTITY=false
# VITE_SKIP_IDENTITY_VERIFICATION=false
# Onboarding: skip Cognito email/SMS codes (demo). Omit/false to test real SES/SNS on localhost.
# VITE_BYPASS_ONBOARDING_VERIFICATION=true

# Backend deploy (Amplify Console env vars): verified SES sender for Cognito sign-up / verify codes
# AMPLIFY_SES_FROM_EMAIL=noreply@modeledmanagement.com
